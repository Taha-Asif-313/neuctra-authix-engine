# Neuctra Authix Engine. Copy to .env, set DATABASE_URL, run `npm run setup`.

# Your own database. Setup only adds its own tables and will not change yours.
#
# PostgreSQL: keep ?schema=authix so Authix stays apart from your own tables.
DATABASE_URL=postgresql://user:password@localhost:5432/mydb?schema=authix
#
# MySQL 8 or later: use a database of its own.
# DATABASE_URL=mysql://user:password@localhost:3306/authix

PORT=5000

# development prints verification codes in this terminal when SMTP is not set.
# Set NODE_ENV=production when you deploy. Secure cookies need HTTPS.
NODE_ENV=development

# Created by `npm run setup`. Changing it signs every user out.
USER_JWT_SECRET=

# Email for verification and password reset codes. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Behind a reverse proxy, set how many proxies sit in front of the engine.
# Leave unset otherwise: a wrong value lets clients forge their IP address.
# TRUST_PROXY_HOPS=1
